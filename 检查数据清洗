"""
数据处理对齐检查脚本

验证 Dataset1 / Dataset2 / Dataset3 经过现有数据清洗流程后，
是否与论文设定基本一致。

运行方式：
    python check_preprocessing_alignment.py
"""

from __future__ import annotations

import sys
import traceback
from pathlib import Path
from typing import Any, Dict, List, Tuple

import pandas as pd

# ── 确保项目根目录在 sys.path ──────────────────────────────────────────────────
ROOT = Path(__file__).resolve().parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from data_preprocessing import (
    build_source_target_split,
    extract_datetime_features,
    load_dataset,
    temporal_split_by_ratio_or_dates,
)

# ══════════════════════════════════════════════════════════════════════════════
# 最小可运行 config（贴合项目默认逻辑，不开启严格论文模式）
# ══════════════════════════════════════════════════════════════════════════════
def _make_config(dataset_name: str) -> Dict[str, Any]:
    return {
        "dataset_name": dataset_name,
        "preprocessing": {
            "source_split_mode": "ratio",
            "target_split_mode": "ratio",
            "source_train_ratio": 0.8,
            "source_val_ratio": 0.1,
            "source_test_ratio": 0.1,
            "target_train_ratio": 0.067,
            "target_val_ratio": 0.067,
            "target_test_ratio": 0.866,
        },
        "paper_reproduction": {
            "strict_paper_mode": False,
            "strict_paper_split": False,
            "paper_split_protocol": {
                "target_observed_window_days": 30,
                "target_forecast_window_days": 180,
            },
        },
    }


# ══════════════════════════════════════════════════════════════════════════════
# 论文对齐期望值
# ══════════════════════════════════════════════════════════════════════════════
PAPER_EXPECTATIONS = {
    "Dataset1": {"train_days": 15, "val_days": 15, "test_days": 180, "tolerance": 5},
    "Dataset2": {"train_days": 14, "val_days": 15, "test_days": 179, "tolerance": 5},
    "Dataset3": {"train_days": 16, "val_days": 15, "test_days": 181, "tolerance": 5},
}

REQUIRED_BASE_COLS   = {"date", "entity_id", "item_id", "sales"}
REQUIRED_FEAT_COLS   = {"year", "month", "week", "day"}
SOURCE_SPLIT_EXPECT  = {"train_ratio": 0.8, "val_ratio": 0.1, "test_ratio": 0.1, "tolerance": 0.05}

# ══════════════════════════════════════════════════════════════════════════════
# 汇总状态收集
# ══════════════════════════════════════════════════════════════════════════════
SUMMARY: Dict[str, Dict[str, str]] = {}


def _status(ok: bool, warn: bool = False) -> str:
    if ok:
        return "✅ PASS"
    if warn:
        return "⚠️  WARN"
    return "❌ FAIL"


def _section(title: str) -> None:
    print(f"\n  ── {title} ──")


def _check_within_tolerance(actual: int, expected: int, tolerance: int) -> bool:
    return abs(actual - expected) <= tolerance


# ══════════════════════════════════════════════════════════════════════════════
# 单数据集检查
# ══════════════════════════════════════════════════════════════════════════════
def check_dataset(dataset_name: str) -> None:
    sep = "═" * 60
    print(f"\n{sep}")
    print(f"  ===== {dataset_name} =====")
    print(sep)

    summary = {
        "标准字段":        "─",
        "时间特征":        "─",
        "target时间窗口":  "─",
        "source/target划分": "─",
        "split合理性":     "─",
    }
    SUMMARY[dataset_name] = summary

    config = _make_config(dataset_name)
    expect = PAPER_EXPECTATIONS.get(dataset_name, {})

    # ── A. 原始加载检查 ───────────────────────────────────────────────────────
    _section("A. 原始加载检查")
    df = load_dataset(dataset_name, "")          # data_path 被模块级常量覆盖
    print(f"  [INFO] 总行数         : {len(df):,}")
    print(f"  [INFO] 列名           : {list(df.columns)}")
    date_min = df["date"].min()
    date_max = df["date"].max()
    unique_days = int(df["date"].nunique())
    print(f"  [INFO] date 范围      : {date_min.date()} ~ {date_max.date()}  ({unique_days} 天)")
    print(f"  [INFO] entity_id 种类 : {df['entity_id'].nunique()}")
    print(f"  [INFO] item_id   种类 : {df['item_id'].nunique()}")

    # ── B. 标准字段检查 ───────────────────────────────────────────────────────
    _section("B. 标准字段检查")
    missing_cols = REQUIRED_BASE_COLS - set(df.columns)
    if not missing_cols:
        print(f"  [PASS] 标准字段齐全: {sorted(REQUIRED_BASE_COLS)}")
        summary["标准字段"] = "✅ PASS"
    else:
        print(f"  [FAIL] 缺失标准字段: {sorted(missing_cols)}")
        summary["标准字段"] = "❌ FAIL"

    # ── C. 时间特征检查 ───────────────────────────────────────────────────────
    _section("C. 时间特征检查")
    df_feat = extract_datetime_features(df)
    df_feat.attrs["dataset_name"] = dataset_name
    missing_feat = REQUIRED_FEAT_COLS - set(df_feat.columns)
    if not missing_feat:
        print(f"  [PASS] 时间特征齐全: {sorted(REQUIRED_FEAT_COLS)}")
        summary["时间特征"] = "✅ PASS"
    else:
        print(f"  [FAIL] 缺失时间特征: {sorted(missing_feat)}")
        summary["时间特征"] = "❌ FAIL"

    # ── D. 缺失值检查 ─────────────────────────────────────────────────────────
    _section("D. 缺失值检查")
    null_counts = df_feat.isnull().sum()
    null_cols = null_counts[null_counts > 0]
    if null_cols.empty:
        print("  [PASS] 无缺失值")
    else:
        for col, cnt in null_cols.items():
            print(f"  [WARNING] 缺失值: {col} = {cnt} 行")

    # ── E. source / target 划分检查 ──────────────────────────────────────────
    _section("E. source / target 划分检查")
    source_df, target_df = build_source_target_split(df_feat, config)

    src_days = int(source_df["date"].nunique())
    tgt_days = int(target_df["date"].nunique())

    print(f"  [INFO] source 行数        : {len(source_df):,}  ({src_days} 唯一天)")
    print(f"  [INFO] target 行数        : {len(target_df):,}  ({tgt_days} 唯一天)")
    print(f"  [INFO] source entity_id   : {source_df['entity_id'].nunique()}")
    print(f"  [INFO] source item_id     : {source_df['item_id'].nunique()}")
    print(f"  [INFO] target entity_id   : {target_df['entity_id'].nunique()}")
    print(f"  [INFO] target item_id     : {target_df['item_id'].nunique()}")

    split_ok = len(source_df) > 0 and len(target_df) > 0
    if split_ok:
        print("  [PASS] source / target 均非空")
        summary["source/target划分"] = "✅ PASS"
    else:
        print("  [FAIL] source 或 target 为空")
        summary["source/target划分"] = "❌ FAIL"

    # ── F. train / val / test 划分检查 ───────────────────────────────────────
    _section("F. train / val / test 划分检查")

    def _print_split(role: str, part_df: pd.DataFrame) -> Tuple[int, int, int]:
        train, val, test = temporal_split_by_ratio_or_dates(part_df)
        for split_name, sdf in [("train", train), ("val", val), ("test", test)]:
            days = int(sdf["date"].nunique()) if not sdf.empty else 0
            d_min = sdf["date"].min().date() if not sdf.empty else "─"
            d_max = sdf["date"].max().date() if not sdf.empty else "─"
            print(
                f"  [INFO] {role:6s} {split_name:5s}: "
                f"rows={len(sdf):6,}  days={days:4d}  "
                f"range=[{d_min} ~ {d_max}]"
            )
        return (
            int(train["date"].nunique()) if not train.empty else 0,
            int(val["date"].nunique())   if not val.empty   else 0,
            int(test["date"].nunique())  if not test.empty  else 0,
        )

    src_train_d, src_val_d, src_test_d = _print_split("Source", source_df)
    tgt_train_d, tgt_val_d, tgt_test_d = _print_split("Target", target_df)

    # ── 论文对齐提示 ─────────────────────────────────────────────────────────
    _section("论文对齐提示")
    tol = expect.get("tolerance", 5)
    exp_train = expect.get("train_days", 15)
    exp_val   = expect.get("val_days",   15)
    exp_test  = expect.get("test_days",  180)

    # target 时间窗口
    target_window_ok = True
    for label, actual, expected in [
        ("target train days", tgt_train_d, exp_train),
        ("target val   days", tgt_val_d,   exp_val),
        ("target test  days", tgt_test_d,  exp_test),
    ]:
        ok = _check_within_tolerance(actual, expected, tol)
        tag = "[PASS]" if ok else "[WARNING]"
        print(
            f"  {tag} {label}: actual={actual}  expected≈{expected}  tolerance=±{tol}"
        )
        if not ok:
            target_window_ok = False
    summary["target时间窗口"] = _status(target_window_ok, warn=not target_window_ok)

    # source 比例合理性
    total_src = src_train_d + src_val_d + src_test_d
    split_ratio_ok = True
    if total_src > 0:
        actual_train_r = src_train_d / total_src
        actual_val_r   = src_val_d   / total_src
        actual_test_r  = src_test_d  / total_src
        tol_r = SOURCE_SPLIT_EXPECT["tolerance"]

        for label, actual_r, expected_r in [
            ("source train ratio", actual_train_r, SOURCE_SPLIT_EXPECT["train_ratio"]),
            ("source val   ratio", actual_val_r,   SOURCE_SPLIT_EXPECT["val_ratio"]),
            ("source test  ratio", actual_test_r,  SOURCE_SPLIT_EXPECT["test_ratio"]),
        ]:
            ok = abs(actual_r - expected_r) <= tol_r
            tag = "[PASS]" if ok else "[WARNING]"
            print(
                f"  {tag} {label}: actual={actual_r:.2f}  expected≈{expected_r:.2f}  tolerance=±{tol_r}"
            )
            if not ok:
                split_ratio_ok = False
    else:
        print("  [WARNING] source split 总天数为 0，无法计算比例")
        split_ratio_ok = False

    summary["split合理性"] = _status(split_ratio_ok, warn=not split_ratio_ok)


# ══════════════════════════════════════════════════════════════════════════════
# 总览汇总表
# ══════════════════════════════════════════════════════════════════════════════
def _print_summary() -> None:
    datasets = ["Dataset1", "Dataset2", "Dataset3"]
    checks   = ["标准字段", "时间特征", "target时间窗口", "source/target划分", "split合理性"]

    col_w   = 16
    item_w  = 10

    sep = "═" * (col_w + item_w * len(checks) + 4)
    print(f"\n{sep}")
    print("  ===== 总览汇总表 =====")
    print(sep)

    # 表头
    header = f"  {'数据集':<{col_w}}" + "".join(f"{c:^{item_w}}" for c in checks)
    print(header)
    print("  " + "─" * (col_w + item_w * len(checks)))

    for ds in datasets:
        result = SUMMARY.get(ds, {})
        row = f"  {ds:<{col_w}}"
        for c in checks:
            cell = result.get(c, "─")
            # 去掉 emoji 后按纯文字对齐（终端宽度补偿）
            row += f"{cell:^{item_w}}"
        print(row)

    print(sep)
    print("  ✅ PASS = 通过  ⚠️  WARN = 偏差在容忍范围外  ❌ FAIL = 明显错误  ─ = 未执行")
    print(sep)


# ══════════════════════════════════════════════════════════════════════════════
# 主入口
# ══════════════════════════════════════════════════════════════════════════════
def main() -> None:
    datasets: List[str] = ["Dataset1", "Dataset2", "Dataset3"]

    for ds in datasets:
        try:
            check_dataset(ds)
        except Exception as exc:
            print(f"\n  [ERROR] {ds} 检查过程中发生异常，跳过该数据集。")
            print(f"  原因: {exc}")
            print("  详细堆栈:")
            traceback.print_exc()
            SUMMARY[ds] = {
                "标准字段":          "❌ ERROR",
                "时间特征":          "❌ ERROR",
                "target时间窗口":    "❌ ERROR",
                "source/target划分": "❌ ERROR",
                "split合理性":       "❌ ERROR",
            }

    _print_summary()


if __name__ == "__main__":
    main()